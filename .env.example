# Set to "false" to hide the demo source (Blender open-movie sample videos).
ENABLE_DEMO_SOURCE=true

# Example config for your own source. See lib/sources/self-hosted.ts.
# SELF_HOSTED_BASE_URL=https://cdn.example.com/anime

# --- Accounts & cross-device sync -------------------------------------------
# Signs login cookies. If unset, one is generated and kept in the database.
# AUTH_SECRET=change-me-to-a-long-random-string

# The owner's password for /admin (invites and accounts), at least 12 characters.
# ADMIN_PASSWORD=
# Optional: sign in to the site itself as "admin" with this name + ADMIN_PASSWORD.
# ADMIN_USER=you@example.com

# Where accounts and synced libraries are stored. Without these, a JSON file in
# .data/ is used — fine on your own PC / a VPS, but NOT on Vercel (files there
# don't persist). On Vercel: Storage → add Upstash Redis, which sets these for you.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# (KV_REST_API_URL / KV_REST_API_TOKEN are accepted too.)

# MyAnimeList import. Create a free client at https://myanimelist.net/apiconfig
# (App type: web, any redirect URL) and paste its Client ID here.
# MAL_CLIENT_ID=

# English title logos on the home page hero. Free key: https://www.themoviedb.org/settings/api
# (the v3 "API Key" or the v4 "API Read Access Token" both work). Without it, shows with an
# English title show it as text instead of TVDB's logo, which is often in Japanese.
# TMDB_API_KEY=

# Anivexa provider (lib/sources/anivexa.ts)
# ANIVEXA_BASE_URL=https://anivexa-api-three.vercel.app

# Two-way AniList sync. Create a client at https://anilist.co/settings/developer
# (instant, no review) with redirect URL https://<your site>/settings/anilist.
# NEXT_PUBLIC_ANILIST_CLIENT_ID=
